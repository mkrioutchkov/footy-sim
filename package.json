{
  "name": "footy-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "native:build": "node scripts/native-build.mjs",
    "native:build:posix": "bash scripts/build-native.sh",
    "preserver": "npm run native:build",
    "server": "tsx tools/cpp-server.ts",
    "cpp-server": "tsx tools/cpp-server.ts",
    "game": "tsx --env-file-if-exists=web/backend/.env web/backend/index.ts",
    "serve": "FOOTY_HOST=0.0.0.0 tsx --env-file-if-exists=web/backend/.env web/backend/index.ts",
    "host": "npm run native:build:posix && vite build && npm run serve",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "prebatch": "npm run native:build",
    "batch": "tsx tools/native-batch.ts",
    "prebenchmark": "npm run native:build",
    "benchmark": "tsx tools/native-batch.ts --matches 8 --minutes 10 --seed 101",
    "prescenarios": "npm run native:build",
    "scenarios": "tsx tools/native-scenarios.ts",
    "prebuild": "npm run native:build",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "pixi.js": "^8.18.1",
    "ws": "^8.21.0"
  }
}
