{
  "name": "footy-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "preserver": "npm run native:build",
    "server": "tsx src/cpp-server.ts",
    "cpp-server": "tsx src/cpp-server.ts",
    "prebatch": "npm run native:build",
    "batch": "tsx src/native-batch.ts",
    "prebenchmark": "npm run native:build",
    "benchmark": "tsx src/native-batch.ts --matches 8 --minutes 10 --seed 101",
    "prescenarios": "npm run native:build",
    "scenarios": "tsx src/native-scenarios.ts",
    "prebuild": "npm run native:build",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "pixi.js": "^8.18.1",
    "ws": "^8.21.0"
  }
}
